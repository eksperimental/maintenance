# Copy this file to .env, fill it in, and run `source .env`.

# Required. The fork that pull requests are opened in (--fork OWNER overrides it).
export GITHUB_ACCOUNT=your-account

# Required only for `mix maintenance.publish`. A token that can push to the fork
# and open pull requests on the upstream repository.
export GITHUB_ACCESS_TOKEN=your-token

# Optional. Commit as someone other than your global Git identity.
# These apply to every Git command in the terminal where you ran `source .env`.
# export GIT_AUTHOR_NAME="Your Name"
# export GIT_AUTHOR_EMAIL="you@example.com"
# export GIT_COMMITTER_NAME="Your Name"
# export GIT_COMMITTER_EMAIL="you@example.com"
